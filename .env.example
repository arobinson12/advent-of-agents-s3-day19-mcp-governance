# ==============================================================================
# Advent of Agents Season 3 — Day 19 Demo Configuration
# ==============================================================================
# Set your Google Cloud Project ID and Region
PROJECT_ID="your-gcp-project-id"
REGION="us-central1"

# Remote Agent Registry MCP Gateway
AGENT_REGISTRY_MCP_URL="https://agentregistry.googleapis.com/mcp"

# Live Cloud Run Streamable HTTP Endpoints (generated by ./deploy_cloud_run_mcp.sh)
LEDGER_V1_URL="https://finserv-ledger-mcp-v1-<project-hash>.<region>.run.app/mcp"
LEDGER_V2_URL="https://finserv-ledger-mcp-v2-<project-hash>.<region>.run.app/mcp"

# Model Armor Floor Setting
MODEL_ARMOR_ENFORCEMENT="ENABLED"
MODEL_ARMOR_INTEGRATED_SERVICES="GOOGLE_MCP_SERVER"
MODEL_ARMOR_ACTION="INSPECT_AND_BLOCK"
